rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Mahsulotlar: hamma o'qiy oladi, faqat tizimga kirgan admin yoza oladi
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Buyurtmalar: mijoz (login qilmagan holda) yangi buyurtma yarata oladi,
    // lekin faqat admin ularni o'qiy/o'zgartira oladi va statusni yangilaydi.
    // Eslatma: "Buyurtmani kuzatish" sahifasi telefon raqami bo'yicha o'qish
    // so'raydi — shu sababli o'qishga ham ruxsat berilgan; agar buni cheklamoqchi
    // bo'lsangiz, Cloud Function orqali proxy qilish tavsiya etiladi.
    match /orders/{orderId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if request.auth != null;
    }
  }
}
